{
  "name": "pixelant/pxa-social-feed",
  "description": "Add Facebook, Instagram, and Twitter feeds to your site.",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "Pixelant\\PxaSocialFeed\\": "Classes/"
    }
  },
  "authors": [
    {
      "name": "Pixelant",
      "email": "info@pixelant.net",
      "homepage": "https://www.pixelant.net",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-backend": "^13.4",
    "typo3/cms-core": "^13.4",
    "typo3/cms-extbase": "^13.4",
    "typo3/cms-fluid": "^13.4",
    "typo3/cms-frontend": "^13.4",
    "typo3/cms-scheduler": "^13.4",
    "league/oauth2-facebook": "^2.3"
  },
  "require-dev": {
    "typo3/testing-framework": "^9.7",
    "phpunit/phpunit": "^11.5",
    "typo3/coding-standards": "^0.9"
  },
  "autoload-dev": {
    "psr-4": {
      "Pixelant\\PxaSocialFeed\\Tests\\": "Tests/"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "scripts": {
    "php:lint": "find Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n 1 php -l",
    "php:cs-fixer": "php-cs-fixer fix --dry-run --diff",
    "php:unittests": "phpunit -c Tests/UnitTests.xml",
    "php:functionaltests": "phpunit -c Tests/FunctionalTests.xml",
    "tests:all": [
      "@php:lint",
      "@php:unittests",
      "@php:functionaltests"
    ]
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "pxa_social_feed",
      "web-dir": ".Build/Web"
    }
  }
}
